# Development profile - 开发环境配置
# ⚠️ 此文件包含个人配置（数据库密码、API密钥等），不应提交到Git
# 已在 .gitignore 中配置，每个开发者维护自己的版本

# 数据库配置 - 根据个人本地环境修改
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/novel2script?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&createDatabaseIfNotExist=true
    username: root
    password:  # TODO: 修改为你的数据库密码

  # AI配置 — 仅千问（qwen3.6-flash），极速准确
  ai:
    default-provider: qwen

    # 嵌入模型配置（文本向量化）
    embedding:
      model: text-embedding-v1    # Qwen embedding 模型, 1536维
      enabled: true               # false = 使用 hash-based fallback

    providers:
      # ── 通义千问多层级模型 — 阿里云百炼 ───────────────
      # qwen-turbo: 极速廉价（简单提取、场景切分、动作生成）
      # temperature 0.3 确保 JSON 输出稳定性
      qwen-turbo:
        api-key:  TODO: 修改为你的api-key
        base-url: https://dashscope.aliyuncs.com/compatible-mode
        chat:
          options:
            model: qwen-turbo
            temperature: 0.3
            max-tokens: 4096
            stream: true

      # qwen-plus: 均衡性价比（对白生成、角色消歧、剧本合成）
      qwen-plus:
        api-key: TODO: 修改为你的api-key
        base-url: https://dashscope.aliyuncs.com/compatible-mode
        chat:
          options:
            model: qwen-plus
            temperature: 0.7
            max-tokens: 4096
            stream: true

      # qwen-max: 最强能力（复杂创意任务，按需启用）
      qwen-max:
        api-key: TODO: 修改为你的api-key
        base-url: https://dashscope.aliyuncs.com/compatible-mode
        chat:
          options:
            model: qwen-max
            temperature: 0.7
            max-tokens: 4096
            stream: true

  # DevTools 热重载配置
  devtools:
    restart:
      enabled: true
      additional-paths: src/main/java
    livereload:
      enabled: true
  # 禁用模板缓存
  thymeleaf:
    cache: false
  # JSON格式化输出
  jackson:
    serialization:
      indent-output: true

# 开发环境日志级别（更详细）
logging:
  level:
    com.novel2script: DEBUG
    org.springframework.ai: DEBUG
    # MyBatis-Plus SQL 日志 — 设为 WARN 关闭 SQL 日志，DEBUG 开启
    com.novel2script.infrastructure.mapper: WARN
    com.baomidou.mybatisplus: WARN
    org.apache.ibatis: WARN

# MyBatis-Plus 开发环境配置
mybatis-plus:
  configuration:
    # 使用 SLF4J（由 logging.level 控制输出），不直接打印到 stdout
    log-impl: org.apache.ibatis.logging.slf4j.Slf4jImpl

# 开发环境服务器配置
server:
  port: 8080
  # 启用详细错误信息
  error:
    include-message: always
    include-binding-errors: always
    include-stacktrace: always
    include-exception: true
